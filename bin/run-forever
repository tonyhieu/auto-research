#!/bin/sh
# Autonomous driver: run-forever [-p lanes] [-c concurrency]  |  run-forever -t "Topic" [-b brief.md] [-a area]  |  run-forever stop
# Roam with parallel topics, e.g. `run-forever -p 2 -c 2` (at most four sandbox simulations at once).
# `stop` asks a running driver to exit gracefully after its current run.
DIR="$(cd "$(dirname "$0")/.." && pwd)"
if [ "$1" = "stop" ]; then
	mkdir -p "$DIR/portfolio"
	: > "$DIR/portfolio/STOP"
	echo "stop requested; the driver exits after the current run"
	exit 0
fi
exec caffeinate -i "$DIR/node_modules/.bin/tsx" "$DIR/src/driver.ts" "$@"
